{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.4.1",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://my.epitech.eu/*"],
  "optional_host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://my.epitech.eu/*"],
      "js": ["content/isolated.js"],
      "css": ["content/shared.css", "content/attendance.css", "content/unit-filters.css", "content/intrastek.css", "content/hide-grades.css", "content/planning-board/planning-board.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://my.epitech.eu/*"],
      "js": ["content/main-world.js"],
      "css": ["content/eval-sheet.css", "content/absence-status.css", "content/student-units.css", "content/promotion-tags.css"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
