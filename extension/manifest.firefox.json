{
  "manifest_version": 3,
  "name": "Intrafeur Toolbox",
  "version": "1.0.0",
  "description": "Persistent color-coded faction tags, sorting and filtering for the Epitech intranet.",
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "epitools@epitech-toolbox.local",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["personallyIdentifyingInfo"],
        "optional": []
      }
    }
  },
  "permissions": ["storage"],
  "host_permissions": ["https://my.epitech.eu/*"],
  "optional_host_permissions": ["<all_urls>"],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://my.epitech.eu/*"],
      "js": ["content/attendance.js"],
      "css": ["content/attendance.css"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Intrafeur Toolbox settings",
    "default_popup": "popup/popup.html"
  }
}
