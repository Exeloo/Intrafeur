{
  "manifest_version": 3,
  "name": "Intrafeur",
  "version": "1.0.0",
  "description": "A toolbox of features that make the Epitech intranet easier to use.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "epitools@epitech-toolbox.local",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["personallyIdentifyingInfo"],
        "optional": []
      }
    }
  },
  "permissions": ["storage"],
  "host_permissions": ["https://my.epitech.eu/*"],
  "optional_host_permissions": ["<all_urls>"],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://my.epitech.eu/*"],
      "js": ["content/attendance.js", "content/unit-filters.js", "content/eval-sheet.js", "content/event-info-toggle.js"],
      "css": ["content/attendance.css", "content/unit-filters.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://my.epitech.eu/*"],
      "js": ["content/event-info.js", "content/eval-sheet-page.js"],
      "css": ["content/event-info.css", "content/eval-sheet.css"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Intrafeur settings",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
