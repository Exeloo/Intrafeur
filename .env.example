# Comma-separated list of bearer tokens accepted by the API.
# Generate one with: openssl rand -hex 32
# Distribute the token(s) to pedagogy staff out-of-band (never commit this file as .env).
ALLOWED_TOKENS=change-me-to-a-long-random-token

PORT=3000

# Firefox self-hosted updates (see extension/scripts/release-firefox.sh).
# Token allowed to upload new signed .xpi releases — keep it separate from
# ALLOWED_TOKENS (which every staff member has). Leave empty to disable uploads.
RELEASE_TOKEN=
# Public https base URL of this backend (used for the update links Firefox downloads).
PUBLIC_URL=https://intrafeur.example.com

# Used only by extension/scripts/release-firefox.sh (npm run release:firefox),
# never by the backend. AMO API credentials:
# https://addons.mozilla.org/developers/addon/api/key/
WEB_EXT_API_KEY=
WEB_EXT_API_SECRET=
# Backend URL the release is uploaded to and baked into the add-on's update_url.
# Optional: defaults to PUBLIC_URL.
# BACKEND_URL=
